{
  "schemaVersion": 1,
  "rules": [
    { "id": "boarding_welcome", "on": "phase.BOARDING", "cue": "pa.boarding", "delay": 3, "category": "boarding",
      "validPhases": ["BOARDING", "PUSHBACK", "ENGINE_START"] },
    { "id": "doors_armed", "on": "phase.PUSHBACK", "cue": "pa.doors", "delay": 2, "category": "crew", "priority": 60,
      "validPhases": ["PUSHBACK", "ENGINE_START", "TAXI"] },
    { "id": "welcome_aboard", "on": "phase.PUSHBACK", "cue": "pa.welcome", "delay": 20, "category": "boarding",
      "validPhases": ["PUSHBACK", "ENGINE_START", "TAXI"] },
    { "id": "safety_briefing", "on": "phase.ENGINE_START", "cue": "pa.safety", "delay": 12, "category": "safety",
      "validPhases": ["ENGINE_START", "TAXI"] },
    { "id": "engine_start_sfx", "on": "phase.ENGINE_START", "cue": "sfx.engine_start", "delay": 0, "category": "chime",
      "enabledByDefault": false },
    { "id": "cabin_prep", "on": "phase.TAXI", "cue": "pa.cabin_prep", "delay": 25, "category": "crew",
      "validPhases": ["TAXI"] },
    { "id": "seats_takeoff", "on": "phase.TAKEOFF", "cue": "pa.takeoff", "delay": 0, "category": "crew", "priority": 70,
      "maxLatency": 8, "validPhases": ["TAKEOFF"] },
    { "id": "seatbelt_chime_climb", "on": "event.altitude.climb.10000", "cue": "sfx.seatbelt", "delay": 20, "category": "chime" },
    { "id": "seatbelt_off", "on": "event.altitude.climb.10000", "cue": "pa.climb", "delay": 24, "category": "crew",
      "validPhases": ["CLIMB", "CRUISE"] },
    { "id": "captain_cruise", "on": "phase.CRUISE", "cue": "pa.cruise", "delay": 45, "category": "captain",
      "validPhases": ["CRUISE"] },
    { "id": "meal_service", "on": "phase.CRUISE", "cue": "pa.service", "delay": 300, "category": "service",
      "validPhases": ["CRUISE"] },
    { "id": "duty_free", "on": "phase.CRUISE", "cue": "pa.duty_free", "delay": 1500, "category": "service",
      "validPhases": ["CRUISE"] },
    { "id": "captain_descent", "on": "phase.DESCENT", "cue": "pa.descent", "delay": 20, "category": "captain",
      "validPhases": ["DESCENT"] },
    { "id": "cabin_secure", "on": "event.altitude.descent.10000", "cue": "pa.cabin_secure", "delay": 5, "category": "crew",
      "validPhases": ["DESCENT", "APPROACH"] },
    { "id": "seatbelt_chime_descent", "on": "event.altitude.descent.10000", "cue": "sfx.seatbelt", "delay": 0, "category": "chime" },
    { "id": "seats_landing", "on": "phase.APPROACH", "cue": "pa.approach", "delay": 5, "category": "crew", "priority": 70,
      "validPhases": ["APPROACH"] },
    { "id": "go_around_explain", "on": "event.goAround", "cue": "pa.go_around", "delay": 40, "category": "captain",
      "repeatable": true, "cooldown": 120 },
    { "id": "arrival_welcome", "on": "phase.TAXI_IN", "cue": "pa.arrival", "delay": 8, "category": "arrival",
      "validPhases": ["TAXI_IN", "PARKED"] },
    { "id": "disarm_doors", "on": "phase.PARKED", "cue": "pa.disarm", "delay": 3, "category": "crew", "priority": 60 },
    { "id": "seatbelt_chime_parked", "on": "phase.PARKED", "cue": "sfx.seatbelt", "delay": 1, "category": "chime" },
    { "id": "disembark", "on": "phase.PARKED", "cue": "pa.disembark", "delay": 20, "category": "arrival",
      "validPhases": ["PARKED", "FLIGHT_ENDED"] }
  ]
}
